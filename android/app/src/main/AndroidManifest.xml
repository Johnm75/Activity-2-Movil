<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto nativo Android de Galería de Fotos (com.example.photo.gallery).
  Autor: John Fredy Marciales Morales | Fecha: 2026-11-06
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cámara declarada como opcional para permitir instalación en emuladores o tablets sin sensor trasero. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- allowBackup="false" evita respaldos no cifrados de tokens JWT y fotografías privadas del sandbox. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Actividad contenedora del WebView Capacitor como punto de entrada del lanzador. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proveedor privado para compartir URIs temporales de captura con el plugin nativo de cámara. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permisos de red, cámara y lectura acotados según versión de Android (API 33+ vs API <= 32). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

</manifest>
